#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
case "${1:-}" in
  -h|--help) printf 'Usage: ./byom PROVIDER [deploy|start|stop|diagnose|destroy] [OPTIONS]\nProviders: fly, hetzner, hpc\nDefault command: start\nUse ./byom PROVIDER --help for options.\n'; exit 0 ;;
  diagnose)
    case "${2:-}" in
      -h|--help) echo 'Usage: ./byom diagnose {fly|hetzner} [OPTIONS]'; exit 0 ;;
      fly|hetzner) provider=$2; shift 2; exec bash "$root/providers/$provider/deploy.sh" diagnose "$@" ;;
      *) echo 'Usage: ./byom diagnose {fly|hetzner} [OPTIONS]' >&2; exit 1 ;;
    esac ;;
  fly|hetzner|hpc) provider=$1; shift; exec bash "$root/providers/$provider/deploy.sh" "$@" ;;
  *) "$root/byom" --help >&2; exit 1 ;;
esac
