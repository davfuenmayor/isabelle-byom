#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
case "${1:-}" in
  -h|--help) printf 'Isabelle BYOM deployment\nUsage: ./byom PROVIDER [OPTIONS]\nProviders: fly, hetzner\nUse ./byom PROVIDER --help for options.\n'; exit 0 ;;
  fly|hetzner) provider=$1; shift; exec bash "$root/providers/$provider/deploy.sh" "$@" ;;
  *) echo 'Usage: ./byom PROVIDER [OPTIONS] (available: fly, hetzner)' >&2; exit 1 ;;
esac
